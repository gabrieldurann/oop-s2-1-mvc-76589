@model Library.MVC.Models.ViewModels.RoleManagementViewModel

@{
    ViewData["Title"] = "Roles";
}

<h1>Role Management</h1>

<form asp-action="CreateRole" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="NewRoleName" class="control-label"></label>
        <input asp-for="NewRoleName" class="form-control" />
        <span asp-validation-for="NewRoleName" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Create Role" class="btn btn-primary" />
    </div>
</form>

<hr />

<h2>Existing Roles</h2>

<table class="table">
    <thead>
    <tr>
        <th>Role Name</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var role in Model.Roles)
    {
        <tr>
            <td>@role</td>
            <td>
                @if (role != "Admin")
                {
                    <form asp-action="DeleteRole" method="post">
                        <input type="hidden" name="roleName" value="@role" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>